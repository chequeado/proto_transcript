# Idioma
STT_LANGUAGE=es

# AssemblyAI (https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=
# universal-3-6-pro (default, ~US$0,45/h) | universal-streaming-multilingual (~US$0,15/h)
ASSEMBLYAI_MODEL=universal-3-6-pro

# yt-dlp
# Archivo de cookies en formato Netscape. Vacío = sin cookies (probar primero así).
YT_COOKIES_FILE=
# node (instalado) o deno (el default de yt-dlp)
YTDLP_JS_RUNTIME=node
# Formato: el audio más liviano. En vivos de YouTube = 233 (audio "low", ~mitad que el 234); para STT alcanza
YTDLP_FORMAT=worstaudio/worst
# Args extra, ej. --force-ipv4 (la app vieja lo usa por un 403 con URLs IPv6)
YTDLP_EXTRA_ARGS=

# Proxies Webshare (rotating residential). Cada corrida usa una sticky session distinta: <user>-<país>-<n>
# off | always | fallback (directo hasta que YouTube rechace con bot_check / 403 / 429)
PROXY_MODE=off
WEBSHARE_USER_BASE=
WEBSHARE_PASS=
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=80
# Países de salida, encadenados con "-" (vacío = cualquiera). Medición 13/10 (bot_check / velocidad):
#   ar: 4 de 6 bot_check (quemado) · cualquiera: 0/6 pero IPs lejanas y lentas (Albania 0,21×)
#   mx uy co cl pe: 0 bot_check, tiempo real, arranque 12–23 s · us/br/py: algún arranque lento o cuelgue
WEBSHARE_COUNTRY=mx-uy-co-cl-pe
# Números de sesión a rotar (1..N)
WEBSHARE_SESSIONS=100

# Segundos sin audio antes de matar y reiniciar la descarga
STALL_SECONDS=30
# Si en los últimos SLOW_WINDOW_SECONDS llega menos de SLOW_RATIO × tiempo real, se cambia de proxy (motivo "slow")
SLOW_RATIO=0.9
SLOW_WINDOW_SECONDS=120

DATA_DIR=data
SAVE_AUDIO=true

# Docker: puerto en 127.0.0.1 y dueño de ./data (id -u / id -g, o 0 si todo corre como root)
APP_PORT=8000
APP_UID=1000
APP_GID=1000
